{
  "manifest_version": 3,
  "name": "臺大選課志願序規劃器",
  "version": "0.5.0",
  "description": "在臺大課程網安排志願序，並於確認差異後安全匯入選課系統。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "臺大選課志願序規劃器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://course.ntu.edu.tw/priority/list/*"
      ],
      "js": [
        "src/sort-utils.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://course.ntu.edu.tw/priority/table"
      ],
      "js": [
        "src/sort-utils.js",
        "src/table.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://if192.aca.ntu.edu.tw/rtcourse/coutake/rt1-runo2-new*"
      ],
      "js": [
        "src/sort-utils.js",
        "src/import-utils.js",
        "src/import.js"
      ],
      "css": [
        "src/import.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
